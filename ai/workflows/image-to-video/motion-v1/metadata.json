{
  "id": "image-to-video.motion-v1",
  "name": "Image-to-Video Motion",
  "category": "image-to-video",
  "version": "1",
  "status": "active",
  "modelRequirements": {
    "type": "video",
    "capabilities": ["image_to_video"]
  },
  "inputs": {
    "sourceImage": { "type": "image", "required": true },
    "prompt": { "type": "string", "required": false },
    "durationSeconds": { "type": "number", "minimum": 1, "maximum": 10, "default": 4 },
    "seed": { "type": "number", "required": false }
  },
  "outputs": {
    "video": { "type": "video", "format": "mp4" }
  }
}
