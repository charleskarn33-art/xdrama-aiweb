# Supabase — public, safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only, NEVER expose to the browser or commit a real value.
# Get these from your Supabase project's Settings > API / Settings > Database.
# If a real value ever ends up here, rotate it immediately in the Supabase
# dashboard and force-push a history rewrite — a placeholder file that once
# held a live key is still a leaked key.
SUPABASE_SERVICE_ROLE_KEY=

# AI Compute (Modal via the ai-server orchestrator) — server-only
AI_COMPUTE_PROVIDER=modal
AI_ORCHESTRATOR_URL=http://127.0.0.1:8787
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
